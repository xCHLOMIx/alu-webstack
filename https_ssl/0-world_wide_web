#!/usr/bin/env bash
# Checking domains and sub domains
function doit ()
{
	echo $(dig "www.$1" | grep -A1 'ANSWER SECTION:' | awk 'NR == 2 {print "The subdomain " $1 " is a " $4 " record and points to " $5}')
	echo $(dig "lb-01.$1" | grep -A1 'ANSWER SECTION:' | awk 'NR == 2 {print "The subdomain " $1 " is a " $4 " record and points to " $5}')
	echo $(dig "web-01.$1" | grep -A1 'ANSWER SECTION:' | awk 'NR == 2 {print "The subdomain " $1 " is a " $4 " record and points to " $5}')
	echo $(dig "web-02.$1" | grep -A1 'ANSWER SECTION:' | awk 'NR == 2 {print "The subdomain " $1 " is a " $4 " record and points to " $5}')
}

doit $1;
