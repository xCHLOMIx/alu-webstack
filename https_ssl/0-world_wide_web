#!/usr/bin/env bash
# Checking domains and sub domains
function doit ()
{
	echo $(dig "www.$1" | grep -A1 'ANSWER SECTION:' | awk 'NR == 2 {print "The subdomain www is a " $4 " record and points to " $5}')
	echo $(dig "lb-01.$1" | grep -A1 'ANSWER SECTION:' | awk 'NR == 2 {print "The subdomain lb-01 is a " $4 " record and points to " $5}')
	echo $(dig "web-01.$1" | grep -A1 'ANSWER SECTION:' | awk 'NR == 2 {print "The subdomain web-01 is a " $4 " record and points to " $5}')
	echo $(dig "web-02.$1" | grep -A1 'ANSWER SECTION:' | awk 'NR == 2 {print "The subdomain web-02 is a " $4 " record and points to " $5}')
}

if [ $# -eq 2 ]
then
	test=$2
	echo $(dig "$2.$1" | grep -A1 'ANSWER SECTION:' | awk -v test="$test" 'NR == 2 {print "The subdomain " test " is a " $4 " record and points to " $5}')
else
	doit $1;
fi
